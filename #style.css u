body {
    background-color: lightblue;
    font-family: Arial, sans-serif;
    color: black;
}

/* NAVIGATION BAR */
nav {
    background-color: darkgreen;
    color: white;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* NAVIGATION HEADING */
nav h2 {
    color: orange;
    font-size: 28px;
}

/* NAVIGATION LIST */
nav ul {
    display: flex;
    list-style: none;
    gap: 25px;
}

/* NAVIGATION LINKS */
nav ul li a {
    color: white;
    text-decoration: none;
    font-size: 18px;
}

/* NAVIGATION HOVER */
nav ul li a:hover {
    color: yellow;
}

/* HERO SECTION */
#hero {
    background-color: seagreen;
    padding: 100px 20px;
    text-align: center;
}

/* HERO HEADING */
.hero h1 {
    color: white;
    font-size: 40px;
    margin-bottom: 30px;
}

/* EXPLORE BUTTON */
.btn {
    background-color: orange;
    color: black;
    padding: 15px 30px;
    border: none;
    border-radius: 8px;
    font-size: 18px;
    cursor: pointer;
}

/* BUTTON HOVER */
.btn:hover {
    background-color: darkorange;
    color: white;
}

/* ABOUT SECTION */
#about {
    background-color: white;
    padding: 60px 20px;
    text-align: center;
}

/* ABOUT HEADING */
.about h2 {
    color: darkgreen;
    font-size: 32px;
    margin-bottom: 20px;
}

/* RESPONSIVE DESIGN */
@media (max-width: 600px) {
    nav {
        flex-direction: column;
        gap: 15px;
    }

    nav ul {
        flex-direction: column;
        text-align: center;
    }

    .hero h1 {
        font-size: 28px;
    }
}